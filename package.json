{
  "name": "api-xeluottoantrung",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "nest start --watch",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "lint": "eslint src test",
    "test": "tsc -p tsconfig.test.json && node --test .test-dist/test/*.test.js",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check",
    "db:ping": "tsx src/database/ping.ts",
    "r2:ping": "tsx src/modules/media/ping.ts",
    "r2:smoke": "tsx src/modules/media/smoke.ts",
    "r2:check-cors": "tsx src/modules/media/check-cors.ts",
    "media:retry-deletes": "tsx src/modules/media/retry-deletes.ts",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx src/database/seed/roles-permissions.ts",
    "db:seed-call-contacts": "tsx src/database/seed/call-contacts.ts --apply",
    "db:seed-recruitment": "tsx src/database/seed/recruitment-article.ts",
    "db:seed-website-content": "tsx src/database/seed/website-content.ts",
    "db:seed-website-settings": "tsx src/database/seed/website-settings.ts --apply",
    "db:seed-seo": "tsx src/database/seed/seo-website.ts --apply",
    "admin:check-user": "tsx src/database/check-auth-user.ts",
    "admin:bootstrap": "tsx src/database/seed/bootstrap-admin.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1140.0",
    "@aws-sdk/s3-request-presigner": "^3.1140.0",
    "@fastify/helmet": "^13.1.1",
    "@fastify/static": "^10.1.4",
    "@nestjs/common": "^12.1.0",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.1.0",
    "@nestjs/platform-fastify": "^12.1.0",
    "@nestjs/swagger": "^12.0.2",
    "@nestjs/throttler": "^6.7.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "18.0.3",
    "drizzle-orm": "0.45.3",
    "jose": "^6.2.12",
    "pg": "8.23.0",
    "pino": "^10.3.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@nestjs/cli": "^12.0.6",
    "@types/node": "26.6.2",
    "@types/pg": "8.23.1",
    "@typescript-eslint/eslint-plugin": "^8.70.1",
    "@typescript-eslint/parser": "^8.70.1",
    "drizzle-kit": "0.31.11",
    "eslint": "^10.11.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  }
}
